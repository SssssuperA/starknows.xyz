{
  "name": "starknows",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "starknows.xyz",
      "custom_domain": true
    }
  ]
}
